# EmailJS Configuration for Portfolio Contact Form
# Sign up & obtain keys at: https://www.emailjs.com/

# 1. Email Service ID (from EmailJS Dashboard -> Email Services)
VITE_EMAILJS_SERVICE_ID=your_service_id

# 2. EmailJS Public Key (from EmailJS Dashboard -> Account -> General -> Public Key)
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# 3. Owner Notification Template ID (sends visitor message to mattadinesh018@gmail.com)
VITE_EMAILJS_OWNER_TEMPLATE_ID=your_owner_template_id

# 4. Visitor Auto-Reply Template ID (sends acknowledgment & copy of message to visitor)
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_autoreply_template_id
